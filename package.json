    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^20.19.43",
    "tsx": "^4.11.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
